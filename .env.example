# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_GROUP_ID=-100xxxxxxxxxx
ADMIN_USER_IDS=123456789,987654321

# LLM Mode: "local" or "api"
LLM_MODE=local

# Local LLM (llama-cpp-python)
LOCAL_MODEL_PATH=./models/phi-3-mini-q4.gguf
LOCAL_MODEL_CONTEXT_LENGTH=4096
LOCAL_MODEL_MAX_TOKENS=512
LOCAL_MODEL_TEMPERATURE=0.7
LOCAL_MODEL_THREADS=4

# API Providers (optional fallback)
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://botuser:password@localhost:5432/telegram_bot_db

# Memory and runtime
MAX_CHAT_HISTORY=50
SESSION_TIMEOUT_MINUTES=60
MUTE_DURATION_MINUTES=60
# Throughput protection: persist every message, fast-moderate spam, and coalesce LLM work.
INFERENCE_QUEUE_SIZE=200
INFERENCE_WORKERS=1
USER_DEBOUNCE_SECONDS=1.2
AI_RESPONSE_COOLDOWN_SECONDS=3
SPAM_WINDOW_SECONDS=12
SPAM_MESSAGES_PER_WINDOW=6
LOG_LEVEL=INFO
LOG_FILE=logs/telegram-ai-manager.log
